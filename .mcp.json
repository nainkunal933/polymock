{
  "mcpServers": {
    "polymock": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "${CLAUDE_PLUGIN_ROOT}/src/main.py"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
