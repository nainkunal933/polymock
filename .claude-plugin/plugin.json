{
  "name": "polymock",
  "version": "0.1.0",
  "description": "Generate synthetic sandbox data and populate SQL Server running in Docker.",
  "author": {
    "name": "nainkunal933"
  },
  "homepage": "https://github.com/nainkunal933/polymock",
  "repository": "https://github.com/nainkunal933/polymock",
  "license": "MIT",
  "mcpServers": {
    "polymock": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "${CLAUDE_PLUGIN_ROOT}/src/main.py"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
